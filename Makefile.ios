# iOS and iPadOS build of the SDL2 port.  Run it through bin/build-ios.sh,
# which builds SDL2 and LZO for the slice first and signs the app:
#
#   make -f Makefile.ios IOS_SLICE=simulator IOS_SDK=iphonesimulator \
#       IOS_TARGET=arm64-apple-ios15.0-simulator
#
# The source lists come from the main Makefile so the builds stay in step.
include Makefile
.DEFAULT_GOAL := ios

IOS_SLICE ?= simulator
IOS_SDK ?= iphonesimulator
IOS_DEPLOYMENT_TARGET ?= 15.0
IOS_TARGET ?= arm64-apple-ios$(IOS_DEPLOYMENT_TARGET)-simulator
IOS_BUNDLE_ID ?= org.wc1re.wingcommander
IOS_OUT_DIR = out-ios/$(IOS_SLICE)
IOS_DEPS ?= $(IOS_OUT_DIR)/deps
IOS_APP_DIR = $(IOS_OUT_DIR)/WingCommander.app
IOS_EXE = $(IOS_OUT_DIR)/wc1
IOS_ICON ?= packaging/3ds/icon.png
IOS_PLATFORM = $(if $(filter iphoneos,$(IOS_SDK)),iPhoneOS,iPhoneSimulator)

IOS_SYSROOT := $(shell xcrun --sdk $(IOS_SDK) --show-sdk-path)
IOS_CC := $(shell xcrun --sdk $(IOS_SDK) --find clang)
IOS_CXX := $(shell xcrun --sdk $(IOS_SDK) --find clang++)
IOS_ARCH = -target $(IOS_TARGET) -isysroot $(IOS_SYSROOT)
IOS_CPPFLAGS = -DSDL_PORT=1 -DSDL_MAIN_HANDLED -Iinclude \
	-I$(IOS_DEPS)/include/SDL2 -I$(IOS_DEPS)/include \
	-I$(IOS_DEPS)/include/lzo
IOS_CFLAGS = -O2 -g -std=c11 -Wno-return-type -Wno-return-mismatch \
	-Wno-error=incompatible-pointer-types \
	$(IOS_ARCH) $(MODERN_SECTION_FLAGS)
IOS_CXXFLAGS = -O2 -g -std=c++14 $(IOS_ARCH) $(MODERN_SECTION_FLAGS)
IOS_OBJCFLAGS = -O2 -g -fobjc-arc $(IOS_ARCH)
IOS_SDL_LIBS = $(shell PKG_CONFIG_LIBDIR=$(IOS_DEPS)/lib/pkgconfig \
	pkg-config --static --libs sdl2)
# As on the Mac: chained fixups cannot hold the pointers at odd offsets in
# the byte-packed recovered tables (aObjectTypeData, aScrambleAnimationActors
# and others), so the link keeps the classic dyld rebase opcodes.
IOS_LDFLAGS = $(IOS_ARCH) -Wl,-dead_strip -Wl,-no_fixup_chains \
	-L$(IOS_DEPS)/lib
IOS_LIBS = $(IOS_SDL_LIBS) -llzo2 -framework CoreText \
	-framework CoreGraphics -framework CoreFoundation -framework UIKit \
	-framework Foundation

IOS_HOST_SRCS = $(filter-out src/sdl/gl_renderer.c, \
	$(MODERN_BASE_HOST_SRCS) $(MODERN_GAME_HOST_SRCS)) \
	$(MODERN_LAUNCHER_SRC) src/sdl/ios.c
IOS_C_SRCS = $(MODERN_GAMEPLAY_SRCS) $(IOS_HOST_SRCS)
IOS_CXX_SRCS = $(MODERN_GAMEPLAY_CXX_SRCS) $(MODERN_IX_SRCS) \
	$(MODERN_GAME_HOST_CXX_SRCS) $(MODERN_YMFM_SRCS)
IOS_OBJC_SRCS = src/sdl/ios_touch.m
IOS_OBJS = $(patsubst %,$(IOS_OUT_DIR)/obj/%.o,$(IOS_C_SRCS) \
	$(IOS_CXX_SRCS) $(MODERN_GAMEPLAY_CXX_C_SRCS) $(IOS_OBJC_SRCS))

.PHONY: ios clean-ios FORCE

ios: $(IOS_APP_DIR)/wc1 $(IOS_APP_DIR)/Info.plist \
	$(IOS_APP_DIR)/AppIcon60x60@2x.png

$(IOS_OUT_DIR)/obj/%.c.o: %.c Makefile.ios
	@mkdir -p $(dir $@)
	$(IOS_CC) $(IOS_CPPFLAGS) $(IOS_CFLAGS) -MMD -MP -c $< -o $@

$(IOS_OUT_DIR)/obj/%.cpp.o: %.cpp Makefile.ios
	@mkdir -p $(dir $@)
	$(IOS_CXX) $(IOS_CPPFLAGS) -Isrc/ix -Ithird_party/ymfm \
		$(IOS_CXXFLAGS) -MMD -MP -c $< -o $@

$(IOS_OUT_DIR)/obj/%.m.o: %.m Makefile.ios
	@mkdir -p $(dir $@)
	$(IOS_CC) $(IOS_CPPFLAGS) $(IOS_OBJCFLAGS) -MMD -MP -c $< -o $@

# UIKit owns the process's main(): ios_touch.m starts it and calls the
# port's main under this name once SDL's application delegate is running.
$(IOS_OUT_DIR)/obj/src/sdl/launcher.c.o: src/sdl/launcher.c Makefile.ios
	@mkdir -p $(dir $@)
	$(IOS_CC) $(IOS_CPPFLAGS) -Dmain=SdlIosGameMain $(IOS_CFLAGS) \
		-MMD -MP -c $< -o $@

# Same as the desktop build: the wave player is C++ and its IxSound objects
# go through the SDL positional-audio bridge.
$(IOS_OUT_DIR)/obj/src/sound.c.o: src/sound.c Makefile.ios
	@mkdir -p $(dir $@)
	$(IOS_CXX) $(IOS_CPPFLAGS) -Isrc/ix \
		-Dix_system_new_sound=SdlNewWaveSound \
		$(IOS_CXXFLAGS) -MMD -MP -x c++ -c $< -o $@

$(IOS_EXE): $(IOS_OBJS)
	$(IOS_CXX) $(IOS_LDFLAGS) $^ $(IOS_LIBS) -o $@

$(IOS_APP_DIR)/wc1: $(IOS_EXE)
	@mkdir -p $(IOS_APP_DIR)
	cp $< $@

# Rewritten every time, so a different IOS_BUNDLE_ID takes effect.
$(IOS_APP_DIR)/Info.plist: packaging/ios/Info.plist.in FORCE
	@mkdir -p $(IOS_APP_DIR)
	sed -e 's/@BUNDLE_ID@/$(IOS_BUNDLE_ID)/' \
		-e 's/@PLATFORM@/$(IOS_PLATFORM)/' \
		-e 's/@DEPLOYMENT_TARGET@/$(IOS_DEPLOYMENT_TARGET)/' $< > $@
	plutil -convert binary1 $@

$(IOS_APP_DIR)/AppIcon60x60@2x.png: $(IOS_ICON)
	@mkdir -p $(IOS_APP_DIR)
	sips -z 120 120 $< --out $(IOS_APP_DIR)/AppIcon60x60@2x.png >/dev/null
	sips -z 180 180 $< --out $(IOS_APP_DIR)/AppIcon60x60@3x.png >/dev/null
	sips -z 152 152 $< --out $(IOS_APP_DIR)/AppIcon76x76@2x~ipad.png >/dev/null
	sips -z 167 167 $< --out $(IOS_APP_DIR)/AppIcon83.5x83.5@2x~ipad.png >/dev/null

clean-ios:
	rm -rf $(IOS_OUT_DIR)/obj $(IOS_EXE) $(IOS_APP_DIR)

-include $(IOS_OBJS:.o=.d)
